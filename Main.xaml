<Window x:Class="Todo3.Main"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="600" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Левая панель -->
        <StackPanel Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Background="White" Margin="10">
            <TextBlock Text="Alex" FontSize="18" Margin="10"/>
            <TextBlock Text="Задачи" FontSize="14" Margin="10"/>
            <TextBlock Text="История" FontSize="14" Margin="10"/>
            <Button Content="+" Width="50" Height="50"/>
        </StackPanel>

        <!-- Верхняя панель -->
        <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" Background="White" Margin="10">
            <TextBlock Text="Дом" Foreground="Green" FontSize="14" Margin="10"/>
            <TextBlock Text="Работа" Foreground="Red" FontSize="14" Margin="10"/>
            <TextBlock Text="Учеба" Foreground="Blue" FontSize="14" Margin="10"/>
            <TextBlock Text="Отдых" Foreground="Purple" FontSize="14" Margin="10"/>
        </StackPanel>

        <!-- Основная область -->
        <ListBox Grid.Column="1" Grid.Row="1" Margin="10">
            <ListBoxItem>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="20" Height="20" Fill="Blue" Margin="5"/>
                    <TextBlock Text="Go fishing with Stephen" FontSize="14"/>
                    <TextBlock Text="9:00" FontSize="12" Margin="5"/>
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="20" Height="20" Fill="Blue" Margin="5"/>
                    <TextBlock Text="Go fishing with Stephen" FontSize="14"/>
                    <TextBlock Text="9:00" FontSize="12" Margin="5"/>
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="20" Height="20" Fill="Blue" Margin="5"/>
                    <TextBlock Text="Read the book Zlatan" FontSize="14"/>
                    <TextBlock Text="9:00" FontSize="12" Margin="5"/>
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="20" Height="20" Fill="Blue" Margin="5"/>
                    <TextBlock Text="Meet accoring with design team..." FontSize="14"/>
                    <TextBlock Text="9:00" FontSize="12" Margin="5"/>
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="20" Height="20" Fill="Blue" Margin="5"/>
                    <TextBlock Text="Meet accoring with design team..." FontSize="14"/>
                    <TextBlock Text="9:00" FontSize="12" Margin="5"/>
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="20" Height="20" Fill="Blue" Margin="5"/>
                    <TextBlock Text="Meet accoring with design team..." FontSize="14"/>
                    <TextBlock Text="9:00" FontSize="12" Margin="5"/>
                </StackPanel>
            </ListBoxItem>
        </ListBox>

        <!-- Модальное окно -->
        <Border Grid.Column="1" Grid.Row="1" Background="White" BorderBrush="Black" BorderThickness="1" Margin="10" Visibility="Collapsed">
            <StackPanel Margin="10">
                <TextBlock Text="Заголовок" FontSize="18"/>
                <TextBlock Text="18:00 01 января 2022" FontSize="14"/>
                <TextBlock Text="Lorem ipsum dolor sit amet, consectetur adipiscing." FontSize="14"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                    <Button Content="Готово" Background="Red" Foreground="White" Margin="5"/>
                    <Button Content="Удалить" Background="Red" Foreground="White" Margin="5"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>