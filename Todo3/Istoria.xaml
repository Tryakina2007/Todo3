<Window x:Class="Todo3.Istoria"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Todo3"
        mc:Ignorable="d"
        Title="Istoria" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Левая панель -->
        <StackPanel Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Background="White" Margin="10">
            <TextBlock Text="Alex" FontSize="18" Margin="10"/>
            <TextBlock Text="Задачи" FontSize="14" Margin="10"/>
            <TextBlock Text="История" FontSize="14" Margin="10"/>
            <Button Content="+" Width="50" Height="50" Margin="10"/>
        </StackPanel>

        <!-- Верхняя панель -->
        <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" Background="White" Margin="10">
            <TextBlock Text="Дом" Foreground="Green" FontSize="14" Margin="10"/>
            <TextBlock Text="Работа" Foreground="Red" FontSize="14" Margin="10"/>
            <TextBlock Text="Учеба" Foreground="Blue" FontSize="14" Margin="10"/>
            <TextBlock Text="Отдых" Foreground="Purple" FontSize="14" Margin="10"/>
        </StackPanel>
        <ListBox Grid.Row="1" Margin="10,10,353,10" Grid.Column="1">
            <ListBoxItem Height="40">
                <StackPanel Orientation="Horizontal">
                    <CheckBox IsChecked="True"/>
                    <TextBlock Text="Meet according with design team..." Margin="5"/>
                    <TextBlock Text="9:00" Margin="5"/>
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem>
                <StackPanel Orientation="Horizontal">
                    <CheckBox IsChecked="True"/>
                    <TextBlock Text="Meet according with design team..." Margin="5"/>
                    <TextBlock Text="9:00" Margin="5"/>
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem>
                <StackPanel Orientation="Horizontal">
                    <CheckBox IsChecked="True"/>
                    <TextBlock Text="Meet according with design team..." Margin="5"/>
                    <TextBlock Text="9:00" Margin="5"/>
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem>
                <StackPanel Orientation="Horizontal">
                    <CheckBox IsChecked="True"/>
                    <TextBlock Text="Meet according with design team..." Margin="5"/>
                    <TextBlock Text="9:00" Margin="5"/>
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem>
                <StackPanel Orientation="Horizontal">
                    <CheckBox IsChecked="True"/>
                    <TextBlock Text="Meet according with design team..." Margin="5"/>
                    <TextBlock Text="9:00" Margin="5"/>
                </StackPanel>
            </ListBoxItem>
        </ListBox>
        <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Margin="370,10,25,211" Grid.Row="1">
            <Grid HorizontalAlignment="Left" Width="290" Margin="30,-9,0,9">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Заголовок" FontWeight="Bold" Margin="112,10,112,10"/>
                <TextBlock Grid.Row="1" Text="18:00 01 января 2022" Margin="0,10,20,10"/>
                <TextBlock Grid.Row="1" Text="Lorem ipsum dolor sit amet, consectetur adipiscing." Margin="0,40,20,-21"/>
            </Grid>
        </Border>
    </Grid>
</Window>
