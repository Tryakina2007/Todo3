<Window x:Class="Todo3.Main_empty"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Todo3"
        mc:Ignorable="d"
        Title="Main_empty" Height="450" Width="800">
    <Grid>
        <Image x:Name="avatarImage" Margin="0,0,689,325" Source="/Image2.png" Stretch="Fill"/>
        <Label Content="Добро пожаловать!" HorizontalAlignment="Left" Margin="211,67,0,0" VerticalAlignment="Top" FontSize="24"/>
        <Label Content="Создате свою первую &#xD;&#xA;задачу!" HorizontalAlignment="Left" Margin="211,114,0,0" VerticalAlignment="Top" FontSize="24"/>
        <Button Content="Выход" HorizontalAlignment="Left" Height="25" Margin="10,109,0,0" VerticalAlignment="Top" Width="89" Click="Button_Click_2"/>
        <Button Content="Изменить фото профиля" HorizontalAlignment="Left" Height="37" Margin="10,151,0,0" VerticalAlignment="Top" Width="147" Click="Button_Click_1"/>
        <Button x:Name="CreateTaskButton" Content="Создать первую задачу" HorizontalAlignment="Center" Margin="0,305,0,0" VerticalAlignment="Top" Background="#FFF96060" BorderBrush="#FFF96060" Foreground="White" Click="Button_Click" Height="37" Width="228" FontSize="16">
            <Button.Resources>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="CornerRadius" Value="10 10 10 10"/>
                </Style>
            </Button.Resources>
        </Button>

    </Grid>
</Window>
