<Page x:Class="Todo3.DobavlenieZadach"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Todo3"
        mc:Ignorable="d"
        Title="DobavlenieZadach" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Левая колонка -->
        <TextBlock Grid.Column="0" Grid.Row="0" Margin="10" Text="Название"/>
        <TextBox Grid.Column="0" Grid.Row="1" Margin="10" Height="30"/>
        <TextBlock Grid.Column="0" Grid.Row="2" Margin="10" Text="Категория"/>
        <TextBox Grid.Column="0" Grid.Row="3" Margin="10" Height="30"/>
        <TextBlock Grid.Column="0" Grid.Row="4" Margin="10" Text="Описание"/>
        <TextBox Grid.Column="0" Grid.Row="4" Margin="10,130,10,-110" Height="100"/>

        <!-- Правая колонка -->
        <TextBlock Grid.Column="1" Grid.Row="0" Margin="10" Text="DataPicker"/>
        <TextBox Grid.Column="1" Grid.Row="1" Margin="10" Height="30"/>
        <TextBlock Grid.Column="1" Grid.Row="2" Margin="10" Text="TimePicker"/>
        <TextBox Grid.Column="1" Grid.Row="3" Margin="10" Height="30"/>

        <!-- Кнопки -->
        <Button Grid.Column="0" Grid.Row="4" Margin="163,165,137,-75" Content="Создать" Background="Green" Foreground="White" Width="100" Height="30" Click="Button_Click"/>
        <Button Grid.Column="1" Grid.Row="4" Margin="150,165,150,-75" Content="Отмена" Background="Red" Foreground="White" Width="100" Height="30" Click="Button_Click_1"/>
    </Grid>
</Page>
