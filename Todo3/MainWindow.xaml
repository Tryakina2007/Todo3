<Page x:Class="Todo3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Todo3"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Image Margin="147,72,518,236" Source="/logot.png"/>
        <Label Content="Добро пожаловать!" HorizontalAlignment="Left" Margin="463,47,0,0" VerticalAlignment="Top" FontSize="24"/>
        <Label Content="Почта" HorizontalAlignment="Left" Margin="463,118,0,0" VerticalAlignment="Top" FontSize="18"/>
        <TextBox HorizontalAlignment="Left" Margin="463,207,0,0" TextWrapping="Wrap" Text="Введите пароль" VerticalAlignment="Top" Width="120" BorderBrush="White" Foreground="#FF959090"/>
        <Button Content="Восстановить пароль" HorizontalAlignment="Left" Margin="569,230,0,0" VerticalAlignment="Top" BorderBrush="White" Background="White" FontSize="16"/>
        <Border BorderBrush="#FF959090" BorderThickness="1" Margin="463,175,65,257" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleY="-1"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Border.RenderTransform>
        </Border>
        <TextBox x:Name="email" HorizontalAlignment="Left" Margin="463,157,0,0" TextWrapping="Wrap" Text="Введите почту" VerticalAlignment="Top" Width="120" BorderBrush="White" Foreground="#FF959090"/>
        <Label Content="Пароль" HorizontalAlignment="Left" Margin="463,180,0,0" VerticalAlignment="Top" FontSize="18"/>
        <Border BorderBrush="#FF959090" BorderThickness="1" Margin="463,227,65,205" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleY="-1"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Border.RenderTransform>
        </Border>
        <Button Content="Войти" HorizontalAlignment="Left" Margin="463,311,0,0" VerticalAlignment="Top" Background="#FFF96060" BorderBrush="#FFF96060" Foreground="White" Click="Button_Click" Height="37" Width="228" FontSize="16">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="10 10 5 5"/>
                </Style>
            </Button.Resources>
        </Button>
        <Button Content="Регистрация" HorizontalAlignment="Left" Margin="463,367,0,0" VerticalAlignment="Top" Background="#FFF96060" BorderBrush="#FFF96060" Foreground="White" Height="34" Width="228" FontSize="16" Click="Button_Click_1">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5 5 10 10"/>
                </Style>
            </Button.Resources>
        </Button>

    </Grid>
</Page>
